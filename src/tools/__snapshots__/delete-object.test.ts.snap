// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`delete-object tool > targetType: comment > should delete a comment by ID 1`] = `
"# Comment Deleted

**Comment ID:** comment-id-1

The comment has been permanently deleted."
`;

